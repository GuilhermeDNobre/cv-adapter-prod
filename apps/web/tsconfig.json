{
  "extends": "@cv-adapter/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": "./",
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "schema": [
        "../../packages/schema/src/index.ts"
      ],
      "schema/*": [
        "../../packages/schema/src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "e2e/**/*",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "vitest.setup.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
