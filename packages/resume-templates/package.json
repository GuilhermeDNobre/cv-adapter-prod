{
  "name": "resume-templates",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@cv-adapter/tsconfig": "workspace:*",
    "@types/node": "^22.13.5",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
